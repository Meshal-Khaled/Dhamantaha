# On The Ring, run "npm run setup" instead of copying this by hand (see DEPLOY.md).
# Locally: copy to .env and fill in real values. Never commit .env.

# --- Server ---
# Loopback by default. Use 0.0.0.0 only inside Docker, behind the reverse proxy, or for LAN phone testing.
HOST=127.0.0.1
PORT=3100
# Proxy hops to trust so per-IP limits see each phone's real address.
# Behind the Cloudflare Tunnel on The Ring: loopback,uniquelocal
TRUST_PROXY=
# Browser origins allowed to call the API (CORS is not authentication).
# Capacitor Android: https://localhost  ·  Vite dev server: http://localhost:5173
CORS_ORIGINS=https://localhost
# Interactive API docs at /docs and /openapi.json, for browser testing.
ENABLE_API_DOCS=true
LOG_LEVEL=info
# Time zone used for each warranty's status (active / expiring_soon / expired).
WALLET_TIME_ZONE=Asia/Riyadh

# --- App access ---
# Optional. When set, requests must send X-Client-Key with one of these keys.
# Format: name:key,name:key (keys at least 16 characters). Keys inside an app can be extracted,
# so this limits casual use; it is not user authentication.
CLIENT_KEYS=

# --- Analysis provider ---
# gemini (default) or mock (fixed sample result for app development; no provider calls).
ANALYSIS_PROVIDER=gemini
# Server-side only. Never put this key in the Android app, browser code, or Git.
GEMINI_API_KEY=
# Alternative: a server-local key file. compose.ring.yaml mounts The Ring's existing key here.
# An inline GEMINI_API_KEY takes precedence when both are set.
GEMINI_API_KEY_FILE=

# --- Private dashboard ---
# Use your existing Ring admin key through compose.ring.yaml; never publish it.
# For local development, set ADMIN_KEY to a private value of at least 16 characters.
ADMIN_KEY=
ADMIN_KEY_FILE=
# Only provider settings/credentials are saved here; never customer receipts.
ADMIN_STATE_DIRECTORY=
# true for production HTTPS; false only for local HTTP development.
ADMIN_COOKIE_SECURE=false
# Dashboard payload capture for the Monitoring page: the last 60 analysis requests (receipt text and
# photo previews included) kept in memory for 60 minutes. Set false to start with it switched off.
DEBUG_CAPTURE=true
# A current Gemini model that supports image and PDF input: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Per provider call, in milliseconds. Behind Cloudflare (100 s request limit) use 40000,
# because a PDF can need two calls.
GEMINI_TIMEOUT_MS=60000

# --- Limits ---
MAX_IMAGE_BYTES=20971520
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=10
# Rejects decompression bombs; 50 MP covers any phone camera.
MAX_IMAGE_PIXELS=50000000
# Photos are shrunk to fit this many pixels on the long side before analysis.
IMAGE_MAX_DIMENSION=3072
# Uploads are held in memory. Peak memory is roughly MAX_CONCURRENT_ANALYSES x MAX_IMAGE_BYTES x 2,
# plus image decoding.
MAX_CONCURRENT_ANALYSES=4
# Analysis requests per minute from one IP address.
RATE_LIMIT_PER_MINUTE=10
# Provider calls per UTC day across all users (0 = no cap). Bounds Gemini spending.
DAILY_PROVIDER_CALL_LIMIT=500

# Fallbacks when a Gemini call fails with an overload, timeout, quota or key error: another model on the
# same key first, then the next key starting again from the primary model. Comma-separated.
GEMINI_FALLBACK_MODELS=
GEMINI_FALLBACK_KEY_FILES=
# Everything one request may spend on Gemini, fallbacks included. Keep it under Cloudflare's 100 seconds.
GEMINI_TOTAL_TIMEOUT_MS=85000
# A Gemini call still unanswered after this long starts the next fallback alongside it; the first good
# answer wins and the rest are cancelled. At most three run at once. 0 turns this off.
GEMINI_HEDGE_AFTER_MS=12000
