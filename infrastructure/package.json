    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  }
