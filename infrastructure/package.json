{
  "name": "dhamantaha-infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "Receipt-analysis infrastructure for Dhamantaha: turns bills into wallet-ready warranty entries.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
