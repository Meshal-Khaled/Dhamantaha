<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp"
    android:background="#f3f6f5" android:clickable="true" android:focusable="true">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="30sp" android:textStyle="bold" android:textColor="#115e59" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/app_lock_title" android:textSize="18sp" android:textColor="#14201f" />
    <TextView android:id="@+id/app_lock_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:gravity="center" android:text="@string/app_lock_message"
        android:textSize="16sp" android:textColor="#5b6b69" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/app_lock_unlock" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:minHeight="52dp" android:text="@string/app_lock_unlock" android:textAllCaps="false"
        android:backgroundTint="#0f766e" android:textColor="#ffffff" />
    <Button android:id="@+id/app_lock_device_settings" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/app_lock_security_settings" android:textAllCaps="false"
        style="?android:attr/borderlessButtonStyle" android:textColor="#0f766e" />
</LinearLayout>
